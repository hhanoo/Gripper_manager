# Docker image name (used in build.sh and run.sh)
# - Default: Docker Hub pre-built image
# - For local build: change to "gripper-manager" and run ./build.sh
IMAGE_NAME="hhanoo/project:gripper-manager"

# Docker container name (used in run.sh)
CONTAINER_NAME="gripper-manager"

# X11 .Xauthority path on host (used in run.sh)
# - Mounted into container as /root/.Xauthority for Qt GUI display.
XAUTHORITY_PATH="$HOME/.Xauthority"
